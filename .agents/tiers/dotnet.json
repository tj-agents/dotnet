{
  "schema_version": 1,
  "tier": "dotnet",
  "stack": ".NET",
  "applies": "stack-present",
  "owner_repository": [
    "tj-agents/dotnet"
  ],
  "detect": {
    "files": [
      "global.json",
      "Directory.Build.props",
      "Directory.Packages.props",
      "NuGet.config"
    ],
    "globs": [
      "*.sln",
      "*.slnx",
      "*.csproj",
      "*.fsproj",
      "*.vbproj",
      "*.cs"
    ]
  }
}
