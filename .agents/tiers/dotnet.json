{
  "schema_version": 1,
  "tier": "dotnet",
  "stack": ".NET",
  "applies": "stack-present",
  "owner_repository": [
    "tj-agents/dotnet"
  ],
  "detect": {
    "files": [
      "global.json",
      "Directory.Build.props",
      "Directory.Packages.props",
      "NuGet.config"
    ],
    "globs": [
      "*.sln",
      "*.slnx",
      "*.csproj",
      "*.fsproj",
      "*.vbproj",
      "*.cs"
    ]
  },
  "routes": [
    {
      "path": "(?i:\\.cs$)",
      "skills": [
        "dotnet:style",
        "dotnet:naming",
        "dotnet:fields"
      ]
    },
    {
      "path": "(?i:\\.[c]s$)",
      "content_requires": "(?m:^[ \\t]*//)",
      "skills": [
        "dotnet:comments"
      ]
    },
    {
      "path": "(?i:(^|/)([^/]+\\.(csproj|sln|slnx)|Directory\\.(Build|Packages)\\.props|Directory\\.Build\\.targets|global\\.json|nuget\\.config))$",
      "skills": [
        "dotnet:build",
        "dotnet:libraries",
        "dotnet:structure"
      ]
    },
    {
      "path": "(?i:(^|/)tests?/|\\.tests[./]|\\.feature$)",
      "skills": [
        "dotnet:testing"
      ]
    },
    {
      "path": "(?i:\\.csproj$)",
      "content_requires": "(?i:<istestproject>\\s*true|microsoft\\.net\\.test\\.sdk)",
      "skills": [
        "dotnet:testing"
      ]
    },
    {
      "path": "(?i:(tests\\.unit|unittests)[./])",
      "skills": [
        "dotnet:testing-unit"
      ]
    },
    {
      "path": "(?i:(tests\\.integration|integrationtests)[./])",
      "skills": [
        "dotnet:testing-integration"
      ]
    },
    {
      "path": "(?i:(tests\\.e2e|e2etests)[./]|\\.feature$)",
      "skills": [
        "dotnet:testing-e2e"
      ]
    },
    {
      "path": "(?i:\\.domain/.*\\.cs$)",
      "skills": [
        "dotnet:domain-design"
      ]
    },
    {
      "path": "(?i:\\.(application|infrastructure)/.*\\.cs$)",
      "skills": [
        "dotnet:structure-modules"
      ]
    },
    {
      "path": "(?i:(controller|endpoint)s?\\.cs$)",
      "skills": [
        "dotnet:http-api"
      ]
    },
    {
      "path": "(?i:\\.contracts/.*\\.cs$|(dto|request|response)s?\\.cs$)",
      "skills": [
        "dotnet:naming-dtos"
      ]
    },
    {
      "path": "(?i:(repository|repositories)\\.cs$)",
      "skills": [
        "dotnet:repositories"
      ]
    },
    {
      "path": "(?i:(^|/)program\\.cs$|(servicecollection|dependencyinjection)[^/]*\\.cs$)",
      "skills": [
        "dotnet:dependency-injection"
      ]
    },
    {
      "path": "(?i:(^|/)log\\.cs$)",
      "skills": [
        "dotnet:logging"
      ]
    },
    {
      "path": "(?i:\\.(cs)$)",
      "content_requires": "(?i:\\bilogger|loggermessage)",
      "skills": [
        "dotnet:logging"
      ]
    },
    {
      "path": "(?i:(\\.cs)$)",
      "content_requires": "(?i:\\bresult<|\\bunitresult<|\\boption<|\\bierror\\b)",
      "skills": [
        "dotnet:errors"
      ]
    },
    {
      "path": "(?i:validators?\\.cs$)",
      "skills": [
        "dotnet:validation"
      ]
    },
    {
      "path": "(?i:mappers?\\.cs$)",
      "skills": [
        "dotnet:mapping"
      ]
    },
    {
      "path": "(?i:extensions?\\.cs$)",
      "skills": [
        "dotnet:mapping"
      ]
    },
    {
      "path": "(?i:seeders?\\.cs$|(^|/)seeding/.*\\.cs$)",
      "skills": [
        "dotnet:seeding"
      ]
    },
    {
      "path": "(?i:\\.proto$)",
      "skills": [
        "dotnet:proto"
      ]
    },
    {
      "path": "(?i:\\.c(s)$)",
      "content_requires": "(?i:\\bidomainevent\\b|\\bieventraiser\\b|domaineventhandler|integrationeventhandler)",
      "skills": [
        "dotnet:domain-events"
      ]
    },
    {
      "path": "(?i:(publisher|consumer|handler)s?\\.cs$)",
      "skills": [
        "dotnet:naming-collaborators",
        "dotnet:domain-events"
      ]
    },
    {
      "path": "(?i:(publisher|processor)s?\\.cs$)",
      "skills": [
        "dotnet:messaging"
      ]
    },
    {
      "path": "(?i:\\.c[s]$)",
      "content_requires": "(?i:\\biintegrationeventpublisher\\b|\\bservicebusprocessor\\b)",
      "skills": [
        "dotnet:messaging"
      ]
    },
    {
      "path": "(?i:(\\.c)s$)",
      "content_requires": "(?i:\\biservicecollection\\b|\\.add(scoped|singleton|transient)\\b)",
      "skills": [
        "dotnet:dependency-injection"
      ]
    },
    {
      "path": "(?i:(resolver|factory|calculator|provider|policy|evaluator|specification|querybuilder|committer)s?\\.cs$)",
      "skills": [
        "dotnet:naming-collaborators"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#domain-ddd)",
      "content_requires": "(?i:\\b(iaggregateroot|aggregateroot|valueobject)\\b|\\bclass\\s+\\w+(?:<[^<>]{0,100}>)?(?:\\([^()]{0,300}\\))?\\s*:\\s*(?:[\\w.]+(?:<[^<>]{0,100}>)?\\s*,\\s*){0,5}(?:i|base|auditable)?entity<)",
      "skills": [
        "dotnet:domain-ddd"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#domain-values)",
      "content_requires": "(?i:\\brecord\\s+struct\\b|\\bbool\\s+try[a-z]\\w*\\s*\\((?:[^()]|\\([^()]{0,200}\\)){0,400}?\\bout\\s)",
      "skills": [
        "dotnet:domain-values"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#errors-carriers)",
      "content_requires": "(?i:\\b(result|unitresult|option)<|\\.(trygeterror|maperror|valueor|tooption|orfailure|bindasync)\\()",
      "skills": [
        "dotnet:errors-carriers"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#errors-results)",
      "content_requires": "(?i:\\bierror\\b|errordefinition\\.)",
      "skills": [
        "dotnet:errors-results"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#errors-terminals)",
      "content_requires": "(?i:\\.(tookorproblem|tonocontentorproblem|tocreatedorproblem|tocreatedatactionorproblem|tocreatedatrouteorproblem|toactionresult|toresults|tookornotfound|tookornocontent|tookor)\\()",
      "skills": [
        "dotnet:errors-terminals"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#keyed-strategies)",
      "content_requires": "(?i:\\[fromkeyedservices|\\.(try)?addkeyed(scoped|singleton|transient)\\b|\\bget(required)?keyedservice\\b|\\bikeyedserviceprovider\\b|\\.require(all|exactly)<)",
      "skills": [
        "dotnet:keyed-strategies"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#keyed-unions)",
      "content_requires": "(?i:\\.case<[\\w.]+>\\(|\\bkeyedunion\\w*|unionfactory\\b)",
      "skills": [
        "dotnet:keyed-unions"
      ]
    },
    {
      "path": "(?i:\\.cs$)(?#microservice-boundaries)",
      "content_requires": "(?i:\\.add(grpcclient|servicediscovery|refitclient|grpc)\\b|\\.mapgrpcservice<|\\bgrpcchannel\\.foraddress\\b)",
      "skills": [
        "dotnet:microservice-boundaries"
      ]
    },
    {
      "path": "(?i:(^|/)directory\\.packages\\.props$)",
      "content_requires": "(?i:meziantou\\.analyzer|\\breunion\\b)",
      "skills": [
        "dotnet:libraries-selected"
      ]
    },
    {
      "path": "(?i:(^|/)\\.scaffold\\.json$)",
      "content_requires": "\"architecture\"\\s*:\\s*\"single-service\"",
      "skills": [
        "dotnet:structure-single-service"
      ]
    },
    {
      "path": "(?i:\\.slnx?$)",
      "content_requires": "(?is:\\A(?!.*[\\\\/]modules[\\\\/])(?!(?:.*?\\.application[\\\\/]){2}).*\\.application[\\\\/])",
      "skills": [
        "dotnet:structure-single-service"
      ]
    }
  ]
}
