{
  "tier": "efcore",
  "stack": "EF Core",
  "applies": "stack-present",
  "detect": {
    "any": [
      {
        "content": {
          "glob": "*.csproj",
          "pattern": "(?i)Microsoft\\.EntityFrameworkCore|Npgsql\\.EntityFrameworkCore|Pomelo\\.EntityFrameworkCore"
        }
      },
      {
        "content": {
          "glob": "Directory.Packages.props",
          "pattern": "(?i)Microsoft\\.EntityFrameworkCore|Npgsql\\.EntityFrameworkCore|Pomelo\\.EntityFrameworkCore"
        }
      },
      {
        "remote": "^tj\\-agents/dotnet$"
      }
    ]
  }
}
