{
  "when": {"tests": {"contains": "integration"}, "database": "sqlserver"},
  "requires": {"tests": {"contains": "integration"}, "database": "sqlserver"},
  "conflicts": {},
  "variables": {
    "FIXTURE_PROVIDER_USING": "using Microsoft.Data.SqlClient;\nusing Testcontainers.MsSql;",
    "FIXTURE_CONTAINER_TYPE": "MsSqlContainer",
    "FIXTURE_CONTAINER_CREATION": "new MsSqlBuilder(\"mcr.microsoft.com/mssql/server:2022-CU14-ubuntu-22.04\")\n    .WithPassword(CreatePassword())\n    .WithPortBinding(1433, true)\n    .WithCreateParameterModifier(parameters => parameters.HostConfig!.PortBindings![\"1433/tcp\"][0].HostIP = \"127.0.0.1\")\n    .Build()",
    "FIXTURE_CONNECTION_TYPE": "SqlConnection",
    "FIXTURE_CONNECTION_CREATION": "new SqlConnection(container.GetConnectionString())",
    "FIXTURE_DB_ADAPTER": "DbAdapter.SqlServer"
  },
  "append": {
    "FIXTURE_PACKAGE_REFERENCES": "    <PackageReference Include=\"Testcontainers.MsSql\" />\n    <PackageReference Include=\"Microsoft.Data.SqlClient\" />",
    "PACKAGE_VERSIONS": "    <PackageVersion Include=\"Testcontainers.MsSql\" Version=\"4.16.0\" />"
  }
}
