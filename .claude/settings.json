{
  "permissions": {
    "allow": [
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(mkdir:*)"
    ]
  },
  "enabledPlugins": {
    "base@tj-agents": true,
    "engineering@tj-agents": true,
    "personal@tj-agents": true,
    "template@tj-agents": true,
    "skill@tj-agents": true,
    "agent@tj-agents": true,
    "agent-store@tj-agents": true,
    "cli@tj-agents": true,
    "workflow@tj-agents": true
  },
  "extraKnownMarketplaces": {
    "tj-agents": {
      "source": {
        "source": "github",
        "repo": "tj-agents/marketplace"
      },
      "autoUpdate": true
    }
  }
}
