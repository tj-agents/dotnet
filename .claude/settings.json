{
  "extraKnownMarketplaces": {
    "tj-agents": {
      "source": {
        "source": "github",
        "repo": "tj-agents/marketplace",
        "ref": "v1.0.0"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "base@tj-agents": true,
    "engineering@tj-agents": true,
    "kit@tj-agents": true,
    "machine@tj-agents": true
  },
  "permissions": {
    "allow": [
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(mkdir:*)"
    ]
  }
}
