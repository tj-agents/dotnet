{
  "tier": "dotnet",
  "stack": ".NET",
  "applies": "stack-present",
  "detect": {
    "any": [
      {
        "file": "global.json"
      },
      {
        "file": "Directory.Build.props"
      },
      {
        "file": "Directory.Packages.props"
      },
      {
        "file": "NuGet.config"
      },
      {
        "glob": "*.sln"
      },
      {
        "glob": "*.slnx"
      },
      {
        "glob": "*.csproj"
      },
      {
        "glob": "*.fsproj"
      },
      {
        "glob": "*.vbproj"
      },
      {
        "glob": "*.cs"
      },
      {
        "remote": "^tj\\-agents/dotnet$"
      }
    ]
  }
}
