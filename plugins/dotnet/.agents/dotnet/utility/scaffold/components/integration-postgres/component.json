{
  "when": {"tests": {"contains": "integration"}, "database": "postgres"},
  "requires": {"tests": {"contains": "integration"}, "database": "postgres"},
  "conflicts": {},
  "variables": {
    "FIXTURE_PROVIDER_USING": "using Npgsql;\nusing Testcontainers.PostgreSql;",
    "FIXTURE_CONTAINER_TYPE": "PostgreSqlContainer",
    "FIXTURE_CONTAINER_CREATION": "new PostgreSqlBuilder(\"postgres:17.4\")\n    .WithPassword(CreatePassword())\n    .WithPortBinding(5432, true)\n    .WithCreateParameterModifier(parameters => parameters.HostConfig!.PortBindings![\"5432/tcp\"][0].HostIP = \"127.0.0.1\")\n    .Build()",
    "FIXTURE_CONNECTION_TYPE": "NpgsqlConnection",
    "FIXTURE_CONNECTION_CREATION": "new NpgsqlConnection(container.GetConnectionString())",
    "FIXTURE_DB_ADAPTER": "DbAdapter.Postgres"
  },
  "append": {
    "FIXTURE_PACKAGE_REFERENCES": "    <PackageReference Include=\"Testcontainers.PostgreSql\" />\n    <PackageReference Include=\"Npgsql\" />",
    "PACKAGE_VERSIONS": "    <PackageVersion Include=\"Testcontainers.PostgreSql\" Version=\"4.16.0\" />"
  }
}
